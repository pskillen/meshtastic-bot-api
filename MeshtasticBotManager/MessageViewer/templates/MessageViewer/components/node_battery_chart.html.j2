<!-- Container for the chart -->
<div id="batteryChart"></div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const batteryLevelData = [
            {% for metric in device_metrics %}
                {x: "{{ metric.logged_time.isoformat() }}", y: {{ metric.battery_level }}},
            {% endfor %}
        ];
        const voltageData = [
            {% for metric in device_metrics %}
                {x: "{{ metric.logged_time.isoformat() }}", y: {{ metric.voltage }}},
            {% endfor %}
        ];

        const options = {
            chart: {
                type: 'line',
                height: 400,
                background: 'transparent',
                foreColor: '#cccccc',
                zoom: {enabled: true},
            },
            series: [
                {
                    name: 'Battery Level (%)',
                    data: batteryLevelData,
                },
                {
                    name: 'Voltage (V)',
                    data: voltageData,
                }
            ],
            stroke: {
                width: 2,
                curve: 'smooth'
            },
            markers: {
                size: 3,
                strokeWidth: 0,
                opacity: 0.4
            },
            xaxis: {
                type: 'datetime',
                title: {text: 'Time'},
                labels: {
                    style: {colors: '#aaa'}
                }
            },
            yaxis: [
                {
                    title: {text: 'Battery Level (%)', style: {color: '#76d9c4'}},
                    min: 0,
                    max: 100,
                    labels: {style: {colors: '#aaa'}}
                },
                {
                    opposite: true,
                    title: {text: 'Voltage (V)', style: {color: '#d0a8ff'}},
                    min: 3.0,
                    max: 4.2,
                    labels: {style: {colors: '#aaa'}}
                }
            ],
            tooltip: {
                theme: 'dark',
                x: {
                    format: 'MMM d, HH:mm'
                }
            },
            legend: {
                labels: {
                    colors: '#ddd'
                }
            },
            grid: {
                borderColor: '#444'
            }
        };

        const chart = new ApexCharts(document.querySelector("#batteryChart"), options);
        chart.render();
    });
</script>
