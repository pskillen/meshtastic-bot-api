<div>
    <div class="flex gap-2 mb-2">
        <button class="btn btn-sm" data-range="24h">24 hours</button>
        <button class="btn btn-sm" data-range="1d">Today</button>
        <button class="btn btn-sm" data-range="2d">2 days</button>
        <button class="btn btn-sm" data-range="7d">7 days</button>
    </div>
    <div id="batteryChart"></div>
    <div id="batteryChartLoading" class="text-sm text-gray-400 mt-2 hidden">Loading...</div>
    <div id="batteryChartError" class="text-sm text-red-500 mt-2 hidden">Failed to load battery data.</div>
</div>

<script>
    let autoRefreshInterval = null;
    let debounceTimeout = null;
    let chart = null;

    function renderGraph(data) {
        const series = [
            {
                name: 'Voltage (V)',
                type: 'line',
                data: data.map(d => ({x: d.time, y: d.voltage})),
                yAxisIndex: 0
            },
            {
                name: 'Battery Level (%)',
                type: 'line',
                data: data.map(d => ({x: d.time, y: d.battery_level})),
                yAxisIndex: 1
            },
            {
                name: 'Ch Util (%)',
                type: 'scatter',
                data: data.map(d => ({x: d.time, y: d.chUtil})),
                yAxisIndex: 1
            },
            {
                name: 'Air Util Tx (%)',
                type: 'scatter',
                data: data.map(d => ({x: d.time, y: d.airUtil})),
                yAxisIndex: 1
            }
        ];

        const options = {
            chart: {
                type: 'line',
                height: 400,
                background: 'transparent',
                foreColor: '#ccc',
                zoom: {enabled: true},
            },
            series: series,
            stroke: {
                width: [2, 2, 0, 0],
                curve: 'smooth'
            },
            markers: {
                size: [3, 3, 5, 5],
                opacity: 0.6,
                strokeWidth: 0
            },
            xaxis: {
                type: 'datetime',
                title: {text: 'Time'},
                labels: {style: {colors: '#aaa'}}
            },
            yaxis: [
                {
                    opposite: true,
                    title: {text: 'Voltage (V)', style: {color: '#d0a8ff'}},
                    min: 3.0,
                    max: 4.2,
                    decimalsInFloat: 2,
                    labels: {style: {colors: '#aaa'}}
                },
                {
                    title: {text: 'Battery/Util (%)', style: {color: '#76d9c4'}},
                    min: 0,
                    max: 100,
                    decimalsInFloat: 1,
                    labels: {style: {colors: '#aaa'}}
                },
            ],
            tooltip: {
                theme: 'dark',
                x: {format: 'MMM d, HH:mm'}
            },
            legend: {labels: {colors: '#ddd'}},
            grid: {borderColor: '#444'}
        };

        if (chart) {
            chart.updateOptions(options);
        } else {
            chart = new ApexCharts(document.querySelector("#batteryChart"), options);
            chart.render();
        }
    }

    function loadBatteryData(timeRange) {
        clearInterval(autoRefreshInterval);
        document.getElementById('batteryChartLoading').classList.remove('hidden');
        document.getElementById('batteryChartError').classList.add('hidden');

        const now = new Date();
        let start;

        // timeRange will be 24h 48h, 1d, 2d, etc
        // split into number and unit
        const timeNumber = parseInt(timeRange.substring(0, timeRange.length - 1));
        const unit = timeRange.substring(timeRange.length - 1);
        console.log(`Loading battery data for ${timeNumber} ${unit}`);

        if (unit === 'd') {
            console.log(`Loading battery data for ${timeNumber} days`);
            start = new Date();
            start.setUTCHours(0, 0, 0, 0);
            start.setUTCDate(start.getUTCDate() - (timeNumber - 1));
        } else {
            console.log(`Loading battery data for ${timeNumber} hours`);
            start = new Date(now.getTime() - timeNumber * 60 * 60 * 1000);
        }

        const startDate = start.toISOString();
        const endDate = now.toISOString();

        const nodeId = "{{ node.id }}";
        const url = `/api/nodes/${nodeId}/device_metrics/?startDate=${encodeURIComponent(startDate)}&endDate=${encodeURIComponent(endDate)}`;

        fetch(url, {credentials: 'same-origin'})
            .then(res => {
                if (!res.ok) throw new Error("Failed to fetch");
                return res.json();
            })
            .then(data => {
                renderGraph(data);
                document.getElementById('batteryChartLoading').classList.add('hidden');
            })
            .catch(err => {
                console.error(err);
                document.getElementById('batteryChartLoading').classList.add('hidden');
                document.getElementById('batteryChartError').classList.remove('hidden');
            });

        // optional: auto-refresh every 5 minutes if on "Today"
        if (unit === 'h' && timeNumber <= 48) {
            autoRefreshInterval = setInterval(() => loadBatteryData(timeRange), 5 * 60 * 1000);
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll("[data-range]").forEach(btn => {
            btn.addEventListener('click', function () {
                const range = this.dataset.range;
                clearTimeout(debounceTimeout);
                debounceTimeout = setTimeout(() => loadBatteryData(range), 250);
            });
        });

        loadBatteryData('24h');
    });
</script>
