<!-- Container for the chart -->
<div id="batteryChart"></div>

<script>
    function mergeAndSortByDate(data1, data2) {
        // Merge the two datasets
        const mergedData = [...data1, ...data2];

        // Sort the merged dataset by date ('x')
        mergedData.sort((a, b) => new Date(a.x) - new Date(b.x));

        return mergedData;
    }

    document.addEventListener('DOMContentLoaded', function () {
        const batteryLevelData1 = [
            {% for metric in device_metrics %}
                {x: "{{ metric.logged_time.isoformat() }}", y: {{ metric.battery_level }}},
            {% endfor %}
        ];
        const batteryLevelData2 = [
            {% for packet in device_metrics_packets %}
                {x: "{{ packet.time.isoformat() }}", y: {{ packet.batteryLevel }}},
            {% endfor %}
        ];
        const batteryLevelData = mergeAndSortByDate(batteryLevelData1, batteryLevelData2);

        const voltageData1 = [
            {% for metric in device_metrics %}
                {x: "{{ metric.logged_time.isoformat() }}", y: {{ metric.voltage }}},
            {% endfor %}
        ];
        const voltageData2 = [
            {% for packet in device_metrics_packets %}
                {x: "{{ packet.time.isoformat() }}", y: {{ packet.voltage }}},
            {% endfor %}
        ];
        const voltageData = mergeAndSortByDate(voltageData1, voltageData2);

        const options = {
            chart: {
                type: 'line',
                height: 400,
                background: 'transparent',
                foreColor: '#cccccc',
                zoom: {enabled: true},
            },
            series: [
                {
                    name: 'Battery Level (%)',
                    data: batteryLevelData,
                },
                {
                    name: 'Voltage (V)',
                    data: voltageData,
                }
            ],
            stroke: {
                width: 2,
                curve: 'smooth'
            },
            markers: {
                size: 3,
                strokeWidth: 0,
                opacity: 0.4
            },
            xaxis: {
                type: 'datetime',
                title: {text: 'Time'},
                labels: {
                    style: {colors: '#aaa'}
                }
            },
            yaxis: [
                {
                    title: {text: 'Battery Level (%)', style: {color: '#76d9c4'}},
                    min: 0,
                    max: 100,
                    labels: {style: {colors: '#aaa'}}
                },
                {
                    opposite: true,
                    title: {text: 'Voltage (V)', style: {color: '#d0a8ff'}},
                    min: 3.0,
                    max: 4.2,
                    labels: {style: {colors: '#aaa'}}
                }
            ],
            tooltip: {
                theme: 'dark',
                x: {
                    format: 'MMM d, HH:mm'
                }
            },
            legend: {
                labels: {
                    colors: '#ddd'
                }
            },
            grid: {
                borderColor: '#444'
            }
        };

        const chart = new ApexCharts(document.querySelector("#batteryChart"), options);
        chart.render();
    });
</script>
