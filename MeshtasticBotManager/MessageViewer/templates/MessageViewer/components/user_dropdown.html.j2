{#
Displays a list of users in a dropdown menu
Needs: all_nodes (a list of MeshNode)
#}

<script>
    function updateMessages() {
        var homeNode = document.getElementById('home-node').value;
        var channel = document.getElementById('channel').value;
        window.location.href = window.location.pathname + '?home-node=' + homeNode + '&channel=' + channel;
    }
</script>

<div class="flex space-x-4 mb-4">
    <div>
        <label for="home-node" class="block text-sm font-medium text-gray-700">Home node:</label>
        <select id="home-node" name="home-node" class="select select-bordered w-full" onchange="updateMessages()">
            <option value="" {% if selected_node_id == '' %}selected{% endif %}>---</option>
            {% for node in all_nodes %}
                <option value="{{ node.id_str }}" {% if node.id_str == selected_node_id %}selected{% endif %}>
                    {{ node.user.short_name }} - {{ node.user.long_name }} ({{ node.id_str }})
                </option>
            {% endfor %}
        </select>
    </div>

    <div>
        <label for="channel" class="block text-sm font-medium text-gray-700">Channel:</label>
        <select id="channel" name="channel" class="select select-bordered w-full" onchange="updateMessages()">
            <option value="-1" {% if selected_channel == '-1' %}selected{% endif %}>---</option>
            {% for i in range(1, 9) %}
                <option value="{{ i-1 }}" {% if i-1 == selected_channel %}selected{% endif %}>
                    Channel {{ i }}
                </option>
            {% endfor %}
        </select>
    </div>
</div>
