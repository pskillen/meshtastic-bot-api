    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Meshtastic Bot Manager{% endblock %}</title>

    {# Global Styles #}
    <link rel="stylesheet" href="{{ static('css/tailwind.css') }}">

    {% block extra_css %}{% endblock %}
